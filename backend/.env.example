# AI API Configuration
# Поддержка: AgentRouter (Claude), Gemini (бесплатно), Groq, Perplexity, OpenAI
#
# СТРАТЕГИЯ ПРОВАЙДЕРОВ ПО ТИПУ ЗАДАЧИ:
# - generation/assistant: agentrouter → gemini-pro → gemini-flash → groq
# - enhancement: gemini-pro → gemini-flash → groq (без agentrouter для экономии)

# ============================================================================
# AgentRouter (Claude Sonnet 4.5) — премиум провайдер для критичных задач
# ============================================================================
# Получить ключ: https://agentrouter.ai
AGENTROUTER_API_KEY=sk-your-agentrouter-key
AGENTROUTER_BASE_URL=https://agentrouter.ai/api/v1  # опционально
AGENTROUTER_MODEL=claude-sonnet-4-5-20250514       # опционально

# ============================================================================
# Gemini API (бесплатно с лимитами)
# ============================================================================
# Получить ключ: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIza...your-key-here
# Gemini Pro — сильная модель (50 RPD лимит)
GEMINI_PRO_MODEL=gemini-2.5-pro-preview-06-05
# Gemini Flash — быстрая модель (250 RPD лимит)
GEMINI_FLASH_MODEL=gemini-2.0-flash-exp
# Проактивные лимиты (переключение до исчерпания)
GEMINI_PRO_LIMIT=45       # Из 50 RPD
GEMINI_FLASH_LIMIT=230    # Из 250 RPD

# Legacy (для обратной совместимости, можно не указывать):
# GEMINI_ENHANCEMENT_MODEL=gemini-2.0-flash-exp
# GEMINI_GENERATION_MODEL=gemini-2.5-pro-preview-06-05
# GEMINI_ASSISTANT_MODEL=gemini-2.0-flash-exp

# Groq API (бесплатно с лимитами)
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ENHANCEMENT_MODEL=llama-3.1-8b-instant

# Perplexity API
PERPLEXITY_API_KEY=pplx-your-key-here
PERPLEXITY_MODEL=llama-3.1-sonar-large-128k-online
PERPLEXITY_ENHANCEMENT_MODEL=llama-3.1-sonar-small-32k-online

# OpenAI API
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_ENHANCEMENT_MODEL=gpt-4o-mini

# Legacy: API_PROVIDER можно указать явно (автоопределяется по ключам)
# Рекомендуется НЕ указывать — система автоматически выберет оптимальный провайдер
# API_PROVIDER=gemini
# API_MODEL=gemini-2.0-flash-exp
API_TEMPERATURE=0.7

# Примечание: AI_PROVIDER_PRIORITY больше не используется для основной логики
# Система использует get_providers_for_task() для выбора провайдеров по типу задачи

# Database Configuration
# Для разработки можно использовать SQLite:
# DATABASE_URL=sqlite:///./usm.db
# Для production используйте PostgreSQL:
DATABASE_URL=postgresql://usm_user:usm_password@localhost:5432/usm_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO
